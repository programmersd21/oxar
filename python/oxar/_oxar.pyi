"""Typing surface for the compiled oxar extension."""

from typing import Any, Literal, final

__all__: list[str]

@final
class CodecEncoder:
    def __new__(
        cls, codec: str, level: int | None = ..., threads: int | None = ...
    ) -> CodecEncoder: ...
    def compress(self, data: bytes) -> bytes: ...
    def flush(self) -> bytes: ...
    def finish(self) -> bytes: ...

@final
class CodecDecoder:
    def __new__(cls, codec: str) -> CodecDecoder: ...
    def decompress(self, data: bytes) -> bytes: ...
    def flush(self) -> bytes: ...
    def finish(self) -> bytes: ...

@final
class _NativeCancelToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...

def compress(
    data: bytes,
    codec: str,
    level: int | None = ...,
    threads: int | None = ...,
) -> bytes: ...
def decompress(data: bytes, codec: str | None = ..., max_size: int | None = ...) -> bytes: ...
def detect(data: bytes) -> dict[str, str]: ...
def list_py(source: str, password: bytes | None = ...) -> list[dict[str, Any]]: ...
def extract_py(
    source: str,
    dest: str,
    password: bytes | None = ...,
    members: list[str] | None = ...,
    policy: dict[str, Any] | None = ...,
    cancel: _NativeCancelToken | None = ...,
) -> tuple[int, int, list[tuple[str, str]], list[str]]: ...
def create_py(dest: str, sources: list[str], format: Literal["zip", "tar"]) -> tuple[int, int]: ...
def convert_py(
    source: str,
    dest: str,
    format: Literal["zip", "tar"],
    password: bytes | None = ...,
    dest_password: bytes | None = ...,
    policy: dict[str, Any] | None = ...,
    cancel: _NativeCancelToken | None = ...,
) -> tuple[int, int, int, int, int]: ...
def rewrite_zip_py(
    archive: str, delete_names: list[str], sources: list[str], replace_existing: bool
) -> tuple[int, int]: ...
def read_entry_py(
    source: str, name: str, password: bytes | None = ..., max_size: int | None = ...
) -> bytes: ...
def test_py(source: str, password: bytes | None = ...) -> dict[str, Any]: ...
